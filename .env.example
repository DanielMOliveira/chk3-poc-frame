# Modelo do .env. Gere o seu com:  ./scripts/init-env.sh
# (cria .env com segredos aleatórios; valores __GERAR__ são substituídos).
# O .env é ignorado pelo git. Nunca commitar segredos.

# ---------- Segredos ----------
POSTGRES_USER=chk3
POSTGRES_PASSWORD=__GERAR__
POSTGRES_DB=chk3poc
# Token estático do canal (substitui Identity Server/APIM no POC). HS256, mínimo 32 bytes.
CHANNEL_JWT_SECRET=__GERAR__
CHANNEL_JWT_ISSUER=chk3-poc-issuer
# Chave dos endpoints internos (substitui Managed Identity no POC).
INTERNAL_API_KEY=__GERAR__
# Assinatura HMAC do snapshot de bandeiras (Integration e API Autorização). Mínimo 32 bytes.
SNAPSHOT_SIGNING_KEY=__GERAR__
# Chave do mock do Gateway.
GATEWAY_API_KEY=__GERAR__
# merchantKey do <verification> do XML do Gateway (passo 11). NUNCA commitar o valor real: ele fica só no .env.
# __GERAR__ cria uma aleatória (o mock e a API Autorização usam a mesma, então funciona em qualquer máquina).
GATEWAY_MERCHANT_KEY=__GERAR__
# Assinatura HMAC-SHA256 do webhook do Worker (header X-Chk3-Signature: t=<unix>,v1=<hex>).
WEBHOOK_SIGNING_SECRET=__GERAR__
# Senha do admin do Grafana (aplicada só na primeira subida do volume grafanadata).
GRAFANA_ADMIN_PASSWORD=__GERAR__

# ---------- Portas e bind no host ----------
# 127.0.0.1 = só a própria máquina (padrão, mais seguro). 0.0.0.0 = todas as interfaces (rede local).
HOST_BIND=127.0.0.1
CANAL_HOST_PORT=8080
OPCOES_HOST_PORT=8081
CARTAO_HOST_PORT=8082
INTEGRATION_HOST_PORT=8083
GRAFANA_HOST_PORT=18184

# ---------- Origens públicas (o que o navegador vê) ----------
# Usadas na CSP/frame-ancestors, no postMessage e na frameUrl. Se ficarem comentadas ou vazias,
# derivam das portas acima: http://localhost:<PORTA>. Atrás de proxy/túnel HTTPS, defina as três.
# CANAL_PUBLIC_ORIGIN=https://canal.exemplo.com
# OPCOES_PUBLIC_ORIGIN=https://checkout.exemplo.com
# CARTAO_PUBLIC_ORIGIN=https://pay.exemplo.com

# ---------- Comportamento do POC ----------
# Timeout da API Autorização para o Gateway e atraso do cartão de timeout no mock.
GATEWAY_TIMEOUT_MS=3000
GATEWAY_MOCK_TIMEOUT_DELAY_MS=10000

# ---------- Gateway: <transaction-request> ----------
# Endpoint completo. Vazio/comentado = gateway-mock (padrão para dev/CI). Na VPS: o endpoint real do Gateway.
# Os PANs de simulação do mock (4111..., 4000...0002, 4000...0119, 5555..., 5105...) vão SEMPRE para o mock,
# então smoke/logs-check nunca geram transação no Gateway real. Só POC_GATEWAY_TEST_PANS seguem para GATEWAY_URL.
# GATEWAY_URL=https://<gateway>/<caminho>
# Cartões de teste do Gateway real (lista separada por vírgula; o do modelo é o padrão).
POC_GATEWAY_TEST_PANS=5453010000066167
GATEWAY_REAL_TIMEOUT_MS=15000
GATEWAY_CONTENT_TYPE=application/xml
# Credenciais do merchant: valor real só no .env da máquina, nunca no repo.
GATEWAY_MERCHANT_ID=00000000
# 1 = CIELO, 20 = STONE, 22 = GETNET (tabela do modelo). PENDENTE: o merchant de homologação usa Rede e Adyen,
# mas o Daniel pediu 22; confirmar com o Gateway o código certo.
GATEWAY_ACQUIRER=1
# softDescriptor padrão (até 13, letras/dígitos/espaço). O POST /sessions pode mandar outro.
GATEWAY_SOFT_DESCRIPTOR=CHK3POC
# PENDENTE: código do <method> para crédito PARCELADO não confirmado com o Gateway (1 = crédito à vista é do modelo).
# 2 é valor provisório do POC, não é fato.
GATEWAY_METHOD_PARCELADO=2
GATEWAY_SAVE_CREDIT_CARD=false
# <environment> logo depois da <merchantKey> no <verification>. Vazio = não envia o elemento.
GATEWAY_ENVIRONMENT=1
# Códigos de retorno (status/code) do Gateway real que significam aprovado / recusado. PENDENTE: tabela não informada.
# Vazio = qualquer código vira Indeterminada.
GATEWAY_APPROVED_CODES=
GATEWAY_DECLINED_CODES=

# ---------- Worker: webhook (passo 16) e expurgo do token do frame ----------
# URL padrão do webhook (https). O cadastro do canal (channels.webhook_url) tem precedência. Vazio = não envia.
# Ex.: https://webhook.site/<seu-id>
WEBHOOK_DEFAULT_URL=
PURGE_INTERVAL_SECONDS=60
# Tokens já usados (tentativa registrada) ficam este tempo antes do expurgo (responde 10b nesse intervalo).
PURGE_USED_GRACE_SECONDS=600

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
