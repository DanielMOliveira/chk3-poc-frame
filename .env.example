# Copie para .env e troque TODOS os segredos (ex.: openssl rand -base64 48).
# O .env é ignorado pelo git. Nunca commitar segredos.

POSTGRES_USER=chk3
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chk3poc

# Token estático do canal (substitui Identity Server/APIM no POC). HS256, mínimo 32 bytes.
CHANNEL_JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-bytes
CHANNEL_JWT_ISSUER=chk3-poc-issuer

# Chave dos endpoints internos (substitui Managed Identity no POC). Mínimo 32 caracteres recomendado.
INTERNAL_API_KEY=troque-por-uma-chave-interna-longa-e-aleatoria
# Assinatura HMAC do snapshot de bandeiras (Integration e API Autorização). Mínimo 32 bytes.
SNAPSHOT_SIGNING_KEY=troque-por-uma-chave-de-assinatura-de-32-bytes
# Chave do mock do Gateway.
GATEWAY_API_KEY=troque-por-uma-chave-do-gateway-mock

# Origens públicas (o navegador usa estas URLs). Na VPS, trocar pelos domínios HTTPS.
CANAL_PUBLIC_ORIGIN=http://localhost:8080
OPCOES_PUBLIC_ORIGIN=http://localhost:8081
CARTAO_PUBLIC_ORIGIN=http://localhost:8082

# Endereço de bind das portas publicadas. 127.0.0.1 = só local. Na VPS, ficar atrás de proxy HTTPS.
BIND_ADDR=127.0.0.1

# Timeout da API Autorização para o Gateway e atraso do cartão de timeout no mock.
GATEWAY_TIMEOUT_MS=3000
GATEWAY_MOCK_TIMEOUT_DELAY_MS=10000
